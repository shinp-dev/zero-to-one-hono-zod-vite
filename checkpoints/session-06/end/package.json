{
  "name": "message-board-checkpoint",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:local:init",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:local:init": "wrangler d1 execute message-board-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "hono": "4.11.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "wrangler": "4.127.0"
  }
}
